[Unit]
Description=Sentinel intranet HTTPS game and durable leaderboard
After=network.target

[Service]
Type=simple
User=sentinel
Group=sentinel
WorkingDirectory=/opt/sentinel-server
ExecStart=/usr/bin/python3 -u /opt/sentinel-server/app.py --root /srv/sentinel/current --db /var/lib/sentinel/scores.sqlite3 --cert /etc/sentinel/tls/server.crt --key /etc/sentinel/tls/server.key
Restart=on-failure
RestartSec=3
UMask=0077
StateDirectory=sentinel
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sentinel
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=1024
TasksMax=96
MemoryMax=512M

[Install]
WantedBy=multi-user.target
